#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    string s; cin >> s;
    int k ;cin >> k;
    int maxi = 0;
    for(int i = 0; i < s.size()-1; i++){
        int zeroes = 0 , ones = 0;
        if(s[i] == 0) zeroes++;
        else ones++;
        for(int j = i+1; j < s.size(); j++){
            if(s[i] == 0) zeroes++;
            else ones++;
            if(abs(zeroes-ones)> 0){
                int val = (zeroes+ones)/2;
                if(k >= val) maxi = max(maxi,j-i+1);
            }
            if(zeroes == ones) maxi = max(maxi,j-i+1);
        }
    }
    cout << maxi ;
}
