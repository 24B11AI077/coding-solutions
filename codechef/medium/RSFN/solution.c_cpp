#include <bits/stdc++.h>
using namespace std;

int main() {
    int n, q;
    cin >> n >> q;

    const long long mod = 1e9 + 7;

    vector<int> nums(n);

    int maxi = 0;

    for (int i = 0; i < n; i++) {
        cin >> nums[i];
        maxi = max(maxi, nums[i]);
    }

    vector<long long> dp(maxi + 1);

    if (maxi >= 1)
        dp[1] = 1;

    if (maxi >= 2)
        dp[2] = 1;

    for (int i = 3; i <= maxi; i++) {
        dp[i] = (dp[i - 1] + dp[i - 2]) % mod;
    }

    for (int i = 0; i < n; i++) {
        nums[i] = dp[nums[i]];
    }

    vector<long long> prefix(n);

    prefix[0] = nums[0];

    for (int i = 1; i < n; i++) {
        prefix[i] = (prefix[i - 1] + nums[i]) % mod;
    }

    while (q--) {
        int x, y;
        cin >> x >> y;

        if (x == 1) {
            cout << prefix[y - 1] << '\n';
        }
        else {
            cout << (prefix[y - 1] - prefix[x - 2] + mod) % mod << '\n';
        }
    }
}