#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int t; cin >> t;
    while(t--){
        int n ; cin >> n;
        vector<int> nums(n);
        int sum = 0;
        int odd = 0;
        for(int i = 0; i < n ; i++){
            cin >>  nums[i]; sum += nums[i];
            if(nums[i]%2 != 0) odd++;
        }
        if(sum % 2 == 0 && odd == 0){
            cout << sum << '\n';
        }
        else if(sum % 2 == 1){
            cout << odd/2 << '\n';
        }
        else {
            cout << sum - (odd / 2) << '\n';
        }
    }
}
