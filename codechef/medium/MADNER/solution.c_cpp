class Solution {
public:
    int findMaximumPairs(const string &s) {
        // write your code here 
        
            
            int n = s.size();
            int count = 0;
            int i = 0;
            while(i < (n-1)){
                if(s[i]!=s[i+1]){
                    i+=2;
                    count++;
                }
                else i++;
            }
           return count;
        
    }
};
