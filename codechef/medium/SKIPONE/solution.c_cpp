#include <bits/stdc++.h>
using namespace std;

int main() {
   
    int t;
    cin >> t;
    
    while (t--) {
        int n;
        long long k;
        cin >> n >> k;
        
        vector<long long> a(n);
        for (int i = 0; i < n; i++) {
            cin >> a[i];
        }
        
        long long sum = 0;
        long long max_val = 0;
        int ans = 0;
        
        for (int i = 0; i < n; i++) {
            sum += a[i];
            max_val = max(max_val, a[i]);
            
            long long cost = sum - max_val;
            
            if (cost <= k) {
                ans = i + 1;
            }
        }
        
        cout << ans << "\n";
    }
    
    return 0;
}