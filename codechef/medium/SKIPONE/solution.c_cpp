#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int t; cin >> t;
    while(t--){
        int n,k; cin >> n >> k;
        vector<int> nums(n);
        int sum = 0;
        bool discount = true;
        int ans = 1;
        int maxi = 0;
        for(int i = 0; i < n; i++) cin >> nums[i];
        int l = 0;
        if(nums[0] > k){
            discount = false;
            l = 1;
        }
        for(int i = l; i < n ; i++){
            if(sum + nums[i] > k){
                if(discount){
                    if(maxi > nums[i]){
                        discount = false;
                        sum -= maxi;
                        sum += nums[i];
                    }
                }
            }
            else sum += nums[i];
            maxi = max(maxi,nums[i]);
        }
        cout << ans << '\n';
    }
}
