#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int t; cin >> t;
    while(t--){
        int n,k; cin >> n >> k;
        vector<int> nums(n);
        int sum = 0;
        bool discount = true;
        int ans = 1;
        int maxi = 0;
        for(int i = 0; i < n; i++) cin >> nums[i];
        for(int i = 0; i < n; i++){
            if(sum + nums[i] > k){
                if(discount){
                    maxi = max(maxi,nums[i]);
                    sum -= maxi;
                    discount = false;
                }
                else break;
            }
            if(sum <= k) ans = i+1;
        }
        cout << ans << '\n';
    }
}
