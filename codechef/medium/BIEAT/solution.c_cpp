#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int n ; cin >> n;
    vector<int> nums(n);
    for(int i = 0; i < n ; i++){
        cin >> nums[i];
    }
    int m ; cin >> m;
    for(int i = 0; i < n ; i++){
        int counter = m;
        while(counter-- && nums[i] > 0){
            nums[i] >>=1;
        }
    }
    for(int val : nums){
        cout << val << " ";
    }
}
