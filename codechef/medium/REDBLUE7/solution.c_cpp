#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int t; cin >> t;
    while(t--){
        int n ; cin >> n;
        vector<int> nums(n);
        vector<int> prefix(n);
        long long sum = 0;
        for(int i = 0; i < n ; i++){
            cin >> nums[i];
            
        }
        sort(nums.begin(),nums.end());
        for(int i = 0 ; i <n ; i++){
            sum += nums[i];
            prefix[i] = sum;
        }
        long long  maxi = LLONG_MIN;
        int cr = n-1, cb = 1;
        int i = n-2 , j =n-1;
        while(i >= 0 && j >= 0){
            long long val = 1LL*cb*prefix[i] + 1LL*cr*(prefix[j]-prefix[i]);
            maxi = max(maxi,val);
            i--;j--;
            cr--;cb++;
        }
        cout << maxi << '\n';
    }
}
