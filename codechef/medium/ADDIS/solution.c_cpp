#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int t; cin >> t;
    while(t--){
        int n; cin >> n;
        vector<long long> nums(n);
        int maxi = 0;
        unordered_map<long long ,int> mp ;
        for(int i = 0; i < n ; i++){
            cin >> nums[i];
            mp[nums[i]]++;
            maxi = max(maxi,mp[nums[i]]);
        }
        if(maxi%2 == 0){
            cout << maxi/2 << '\n';
        }
        else {
            cout << (maxi/2)+1 << '\n';
        }
    }
}
