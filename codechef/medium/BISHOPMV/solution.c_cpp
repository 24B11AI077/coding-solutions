#include <iostream>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int x1, y1, x2, y2;
        cin >> x1 >> y1 >> x2 >> y2;

        if ((x1 + y1 == x2 + y2) || (x1 - y1 == x2 - y2))
            cout << 1 << "\n";
        else if ((x1 + y1) % 2 != (x2 + y2) % 2)
            cout << -1 << "\n";
        else
            cout << 2 << "\n";
    }

    return 0;
}