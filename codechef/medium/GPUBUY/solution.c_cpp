#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;
    while (t--) {
        int x, y, z;
        cin >> x >> y >> z;

        if (z <= y) {
            cout << -1 << '\n';
        } else {
            int d = z - y;
            cout << (x + d - 1) / d << '\n';
        }
    }

    return 0;
}