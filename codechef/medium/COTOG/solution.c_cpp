#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int n; cin >> n;
    vector<int> nums(2*n);
    for(int i = 0; i < 2*n ; i++) cin >> nums[i];
    unordered_map<int,int> mp;
    int key = 0, value = 1;
    while(key <= 2*n-2){ // 0 1 2
        mp[key] = value;
        key= value+1; value+=2;
    }
    int count = 0;
    int i = 0;
    while(i < 2*n-1){
        int mini = min(nums[i],nums[i+1]);
        int maxi = max(nums[i],nums[i+1]);
        if(mp[mini] != maxi) count++;
        i+=2;
    }
    cout << count/2+count%2 ;
}
//  5 0 3 1 4 2