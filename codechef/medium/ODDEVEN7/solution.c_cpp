#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int t; cin >> t;
    while(t--){
        int n ;cin >> n;
        vector<int> nums(n);
        int even = 0,odd = 0;
        for(int i = 0; i < n ; i++) {
            cin >> nums[i];
            if(nums[i]%2 == 0) even++;
            else odd++;
        }
        if(even == odd) cout << 2*odd << '\n';
        else cout << 2*min(even,odd)+1 << '\n';
    }
}
