#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int t; cin >> t;
    while(t--){
        int n; cin >> n;
        string str1,str2 ; cin >> str1 >> str2;
        sort(str1.begin(),str1.end());
        sort(str2.rbegin(),str2.rend());
       
        string res = "YES";
        int i = 0;
        while(i < n){
            if(str1[i] == str2[i]){
                res = "NO";break;
            }
            i++;
        }
        cout << res  << '\n';
    }
}
