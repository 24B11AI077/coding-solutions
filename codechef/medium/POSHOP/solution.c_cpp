#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int t; cin >> t;
    while(t--){
        int n ; cin >> n;
        vector<int> a(n);
        int maxi = 0;
        for(int i = 0; i < n ; i++){
            cin >> a[i];
            maxi = max(maxi,a[i]);
        }
        for(int i = 0; i < n-1 ; i++){
            for(int j =i+1; j < n ; j++){
                if(a[i] <= a[j]){
                    maxi = max(maxi,a[i]+a[j]);
                }
            }
        }
        cout << maxi << '\n';
    }
}
