#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int n,k; cin >> n >> k;
    vector<int> nums(n);
    int maxi = INT_MIN,mini = INT_MAX;
    
    for(int i = 0;  i  < n ; i++){
        cin >> nums[i];
       
    }
    sort(nums.begin(),nums.end());
    int val1= nums[0];
    int val2 = nums[n-1];
    val1 += k;
    if(val2-k < 0) val2+=k;
    else val2-=k;
    cout << val2-val1 ;
}
