#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int n,k; cin >> n >> k;
    vector<int> nums(n);
    int maxi = INT_MIN,mini = INT_MAX:
    for(int i = 0;  i  < n ; i++){
        cin >> nums[i];
        if(nums[i]-k < 0){
            nums[i] += k;
            mini = min(mini,nums[i]);
            maxi = max(maxi,nums[i]);
        }
        else {
            nums[i]-=k;
              mini = min(mini,nums[i]);
            maxi = max(maxi,nums[i]);
        }
    }
    cout << maxi - mini ;
// 1 1 0 0
