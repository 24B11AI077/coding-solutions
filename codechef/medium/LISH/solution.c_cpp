#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int w; cin >> w;
    int n ;cin >> n;
    vector<int> nums(n);
    for(int i = 0; i < n ; i++){
        cin >> nums[i];
    }
    sort(nums.rbegin(),nums.rend());
    int re = w;
    int cnt = 0;
    for(int i = 0; i < n ; i++){
        if(nums[i] >= re){
            cnt++;
            re = 0;
            break;
        }
        if(nums[i]*2 >= re){
            re = 0;
            cnt+=2;break;
        }
        cnt+=2;
        re = w-nums[i]*2;
    }
    if(re > 0 ) cout << -1;
    else 
    cout << cnt;
}
