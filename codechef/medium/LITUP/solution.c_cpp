#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int t; cin >> t;
    while(t--){
        int n,k; cin >> n >> k;
        vector<int> nums(n);
        for(int i = 0; i < n ; i++){
            cin >> nums[i];
        }
        int res = INT_MAX;
        for(int i = 0; i < n-1 ; i++){
            for(int j =i+1; j < n ; j++){
                int mini = min(i-k,j-k);
                int maxi = max(i+k,j+k);
                if(mini <= 0 && maxi >= n-1 && (i+k+1) >= (j-k)){
                    res = min(res,nums[i]+nums[j]);
                }
                
            }
        }
        if(res == INT_MAX) cout << -1 << '\n';
        else cout << res << '\n';
    }
}

