#include <iostream>
#include <vector>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        vector<int> a(n + 1);
        for (int i = 1; i <= n; i++)
            cin >> a[i];

        int ans = 0;
        int sum = 0;

        for (int i = 2; i <= n; i++) {
            if (a[i] > 0)
                sum += a[i];

            ans = max(ans, 1 + sum - i);
        }

        cout << ans << "\n";
    }

    return 0;
}