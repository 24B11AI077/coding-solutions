#include <bits/stdc++.h>
using namespace std;

int main() {
    string s;
    getline(cin, s);

    vector<int> freq(26, 0);

    for (char ch : s) {
        ch = tolower(ch);

        if (ch >= 'a' && ch <= 'z') {
            freq[ch - 'a']++;
        }
    }

    int maxFreq = 0;
    char answer = 'a';

    for (int i = 0; i < 26; i++) {
        if (freq[i] > maxFreq) {
            maxFreq = freq[i];
            answer = 'a' + i;
        }
    }

    cout << answer << '\n';

    return 0;
}