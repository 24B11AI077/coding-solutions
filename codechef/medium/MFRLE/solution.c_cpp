    int t; cin >> t;
    while(t--){
        string s ; cin >> s;
        char ch = 'a';
        int maxi = 0;
        for(int i = 0; i < s.size(); i++){
            if(s[i] >= 'a' && s[i] <= 'z'){
                mp[s[i]]++;
                if(maxi > mp[s[i]]){
