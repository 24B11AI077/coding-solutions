#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    
    int t; cin >> t;
    while(t--){
        string s ; cin >> s;
        char ch = 'a';
        int maxi = 0;
        unordered_map<char,int> mp;
        for(int i = 0; i < s.size(); i++){
            char c = tolower(s[i]);
            if(c>= 'a' && c <= 'z'){
                mp[c]++;
                if(maxi > mp[c]){
                    ch = c;
                    maxi = mp[c];
                }
                else if(maxi == mp[c]){
                    if(c< ch) ch = c;
                }
            }
        }
    }
}
