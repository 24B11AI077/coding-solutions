#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        vector<int> a(n);

        for (int i = 0; i < n; i++) {
            cin >> a[i];
        }

        int l = -1e9;
        int r = 1e9;
        bool ok = true;

        for (int i = 0; i < n / 2; i++) {
            int x = a[i];
            int y = a[n - 1 - i];

            if (x == y) {
                continue;
            }

            if (abs(x - y) != 2) {
                ok = false;
                break;
            }

            l = max(l, min(x, y));
            r = min(r, max(x, y) - 1);
        }

        if (ok && l <= r)
            cout << "YES\n";
        else
            cout << "NO\n";
    }

    return 0;
}