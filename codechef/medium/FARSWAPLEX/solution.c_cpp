#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
   
    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        vector<int> p(n), pos(n + 1);
        for (int i = 0; i < n; i++) {
            cin >> p[i];
            pos[p[i]] = i;
        }

        vector<vector<int>> adj(n + 1);
        vector<int> indeg(n + 1, 0);

        for (int x = 1; x < n; x++) {
            if (pos[x] < pos[x + 1]) {
                adj[x].push_back(x + 1);
                indeg[x + 1]++;
            } else {
                adj[x + 1].push_back(x);
                indeg[x]++;
            }
        }

        priority_queue<int, vector<int>, greater<int>> pq;
        for (int x = 1; x <= n; x++) {
            if (indeg[x] == 0) pq.push(x);
        }

        vector<int> ans;
        while (!pq.empty()) {
            int u = pq.top();
            pq.pop();

            ans.push_back(u);

            for (int v : adj[u]) {
                indeg[v]--;
                if (indeg[v] == 0) pq.push(v);
            }
        }

        for (int i = 0; i < n; i++) {
            if (i) cout << ' ';
            cout << ans[i];
        }
        cout << '\n';
    }
}
