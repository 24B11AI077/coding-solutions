#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int t;cin >> t;
    while(t--){
        int n; cin >> n;
        vector<int> nums(n);
        for(int i = 0; i < n ; i++){
            cin >> nums[i];
        }
        vector<int> copy = nums;
        for(int i = 0; i < n ; i++){
            int val = nums[i];
            int idx = 0;
            while(val!=copy[idx] && idx < n){
                idx++;
            }
           while(idx < n-1 && abs(copy[idx]-copy[idx+1]) > 1 && copy[idx] > copy[idx+1]){
               swap(copy[idx],copy[idx+1]);
               idx++;
           }
        }
       
        for(int i = 0; i < n ; i++){
            cout << copy[i] <<  " ";
        }
        cout << '\n';
    }
}
