#include <bits/stdc++.h>
using namespace std;

int main() {
   
    
    int t; 
    cin >> t;
    while(t--) {
        int n;
        cin >> n;
        vector<long long> A(n);
        for(int i = 0; i < n; i++) {
            cin >> A[i];
        }
        
        long long ans = 0;
        long long prev = 0; 
        
        for(int i = 0; i < n; i++) {
            long long B_i = (i % 2 == 0) ? A[i] : -A[i];
            ans += llabs(B_i - prev);
            prev = B_i;
        }
        
        ans += llabs(0 - prev);
        
        cout << ans / 2 << '\n';
    }
    return 0;
}