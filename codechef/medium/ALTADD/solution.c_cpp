        for(int i =0; i < n ; i++){
            cin >> nums[i];
            
        }
        int po = 0,ne = 0;
        if(nums[0] < 0) ne =1;
        else po = 1;
        long long count = 0;
        long long maxi = 0;
        for(int i = 0; i < n ; i++){
            if(po && nums[i] > 0){
                maxi = max(maxi,abs(nums[i]));
                po = 0;ne = 1;
            }
            else if(ne && nums[i] < 0){
                maxi = max(maxi,abs(nums[i]));
                po = 1;ne = 0;
            }
            else if(nums[i] == 0){
                sum += maxi;
                maxi = 0;
                if(i+1 < n){
                    if(nums[i] < 0) ne = 1;
                    else po = 1;
                }
            }
            else {
                count += maxi ;
                maxi = abs(nums[i]);
                if(nums[i] < 0) po =1;
                 else ne = 1;
            }
        }
        count += maxi;
        cout << count << '\n';
    }
}