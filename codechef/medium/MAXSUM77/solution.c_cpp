#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int t ; cin >> t;
    while(t--){
        int n,k; cin >> n >> k;
        int i = 0, j = n-1;
        vector<int> nums(n);
        int w = n-k;
        int sum = 0;
        for(int i = 0; i < n ; i++) {
            cin >> nums[i];
            if(i < w) sum += nums[i];
        }
        
    }
}
