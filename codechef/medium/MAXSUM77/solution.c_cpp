#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int t ; cin >> t;
    while(t--){
        int n,k; cin >> n >> k;
        int i = 0, j = n-1;
        vector<int> nums(n);
        for(int i = 0; i < n ; i++) cin >> nums[i];
        while(i <= j && k > 0){
            if(nums[i] > nums[j]){
                j--;
            }
            else {
                i++;
            }
            k--;
        }
        int sum = 0;
        for(int l = i; l <= j ; l++) sum += nums[l];
        cout << sum << '\n';
    }
}
