#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    string s,p; cin >> s >> p;
    int k = p.size();
    sort(p.begin(),p.end());
    vector<int> res;
    for(int i = 0; i <= s.size() - k; i++){
        string temp(s.begin()+i,s.begin()+i+k);
        sort(temp.begin(),temp.end());
        if(temp == p) res.push_back(i);
    }
    for(int val : res) cout << val << " ";
}
