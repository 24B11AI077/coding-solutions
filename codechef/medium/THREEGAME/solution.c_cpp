#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int t; cin >> t;
    while(t--){
        int n ;cin >> n;
        if(n%3 == 1 ) cout << n << '\n';
        else if(n%3 == 0) cout << n +1 << '\n';
        else {
            long long val = (n/3) + 1;
            long long res = (long long)(val*3) + 1;
            cout << res << '\n';
        }
    }
}
