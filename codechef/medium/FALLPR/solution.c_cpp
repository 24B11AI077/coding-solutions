#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int t; cin >> t;
    while(t--){
        int n; cin >> n;
        vector<int> nums(n);
        for(int i = 0;i < n ; i++){
            cin >> nums[i];
        }
        long long sum = 0;
        int mini = 0;
        for(int i = 0; i < n ; i++){
            sum += nums[i];
            mini = min(mini,nums[i]);
        }
        if(sum >= 0 ) cout << "YES\n";
        else if(sum < 0){
            sum += -1*mini;
            if(sum >= 0) cout << "YES\n";
            else cout <<"NO\n";
        }
    }
}
