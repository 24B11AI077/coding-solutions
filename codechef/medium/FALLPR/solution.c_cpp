#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int t; cin >> t;
    while(t--){
        int n; cin >> n;
        vector<int> nums(n);
        int mini = 0;
        for(int i = 0;i < n ; i++){
            cin >> nums[i];
            mini = min(mini,nums[i]);
        }
        long long sum = 0;
        bool removed = false;
        string res = "YES";
        for(int i = 0;  i < n ; i++){
            if(nums[i] == mini && mini < 0 && !removed){
                removed = true;
            }
            else {
                sum += nums[i];
                if(sum < 0){
                    res = "NO";
                    break;
                }
                
            }
        }
        cout << res << '\n';
    }
}
