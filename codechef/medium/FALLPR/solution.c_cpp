#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int t; cin >> t;
    while(t--){
        int n; cin >> n;
        vector<int> nums(n);
        for(int i = 0;i < n ; i++){
            cin >> nums[i];
        }
        string res = "YES";
        int sum = 0;
        bool updated = true;
        for(int i = 0; i < n ; i++){
            sum += nums[i];
            if(sum < 0 && !updated){
                res = "NO";
                break;
            }
            else if(sum < 0 && updated){
                sum -= nums[i];
                updated =true;
            }
        }
        cout << res << '\n';
    }
}
