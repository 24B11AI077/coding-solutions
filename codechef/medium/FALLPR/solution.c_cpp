#include <bits/stdc++.h>
using namespace std;

int main() {
    int t; cin >> t;

    while(t--){
        int n; cin >> n;

        vector<int> nums(n);

        for(int i = 0; i < n; i++){
            cin >> nums[i];
        }

        long long sum = 0;
        int mini = 0;
        bool removed = false;
        string res = "YES";

        for(int i = 0; i < n; i++){
            sum += nums[i];

            mini = min(mini, nums[i]);

            if(sum < 0){
                if(removed){
                    res = "NO";
                    break;
                }

                sum -= mini;
                removed = true;
            }
        }

        cout << res << '\n';
    }
}