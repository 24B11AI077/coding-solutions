#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int t; cin >> t;
    while(t--){
        int x,y,a,b,c; cin >> x >> y >> a >> b >> c;
        int fc = 0;
        if(x%2 == 0) {
            fc = x/2;
            if(y%2 == 0){
                fc = fc + y/2;
            }
            else fc += (y/2)+1;
        }
        else {
            fc = (x/2)+1;
            if(y%2 == 0) fc += (y/2);
            else fc += (y/2)+1;
        }
    }
}
