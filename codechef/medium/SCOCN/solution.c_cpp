#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int n ;cin >> n ; 
    vector<int> nums(n);
    for(int i = 0; i < n ;i++) cin >> nums[i];
    int x; cin >> x;
    int res = -2;
    int cnt = 0;
    for(int i = 0; i < n; i++){
        if(nums[i] == x) cnt++;
        if(cnt == 2) {
            res = i;
            break;
        }
    }
    if(cnt == 1) cout << -1;
    else cout << res;
}
