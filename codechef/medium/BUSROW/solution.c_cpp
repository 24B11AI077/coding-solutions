#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int t; cin >> t;
    while(t--){
        int n , m, x; cin >> n >> m >> x;
        for(int i = 1; i <= n; i++){
            if(x <= m*i){
                cout << min(n-i+1,i) << '\n';
                break;
            }
        }
    }
}
